{
  "id": "SetParagraphFormat",
  "name": "Задать формат абзаца",
  "description": "Задать формат указанного абзаца (размер шрифта, шрифт, полужирный, курсив, цвет, выравнивание и т. д.)",
  "appType": "word",
  "category": "Операции",
  "riskLevel": "safe",
  "isVbaFallback": false,
  "parameters": [
    {
      "name": "paragraphIndex",
      "type": "number",
      "required": true,
      "description": "Индекс абзаца (начиная с 1)"
    },
    {
      "name": "fontSize",
      "type": "number",
      "required": false,
      "description": "Размер шрифта (пт)"
    },
    {
      "name": "fontName",
      "type": "string",
      "required": false,
      "description": "Название шрифта"
    },
    {
      "name": "bold",
      "type": "boolean",
      "required": false,
      "description": "Полужирный"
    },
    {
      "name": "italic",
      "type": "boolean",
      "required": false,
      "description": "Курсив"
    },
    {
      "name": "color",
      "type": "string",
      "required": false,
      "description": "Цвет (red/blue/black и т. д.)"
    },
    {
      "name": "alignment",
      "type": "string",
      "required": false,
      "description": "Выравнивание (left/center/right)"
    }
  ],
  "examples": [
    {
      "description": "Изменить размер шрифта 1-го абзаца на 28 пт",
      "params": {
        "paragraphIndex": 1,
        "fontSize": 28
      }
    },
    {
      "description": "Сделать 3-й абзац полужирным и выровнять по центру",
      "params": {
        "paragraphIndex": 3,
        "bold": true,
        "alignment": "center"
      }
    }
  ]
}
