{
  "id": "DataAnalysis",
  "name": "Анализ данных",
  "description": "Сформировать по диапазону данных Excel статистическую сводку, группировку, рейтинг или сводную таблицу",
  "appType": "excel",
  "category": "Работа с данными",
  "riskLevel": "medium",
  "isVbaFallback": false,
  "parameters": [
    {
      "name": "sourceRange",
      "type": "string",
      "required": true,
      "description": "Исходный диапазон данных, например A1:F100 или {selection}"
    },
    {
      "name": "type",
      "type": "string",
      "required": true,
      "description": "Тип анализа: summary/pivot/groupby/ranking"
    },
    {
      "name": "targetRange",
      "type": "string",
      "required": false,
      "description": "Верхняя левая ячейка результата"
    },
    {
      "name": "groupBy",
      "type": "string",
      "required": false,
      "description": "Имя поля группировки для groupby"
    },
    {
      "name": "valueField",
      "type": "string",
      "required": false,
      "description": "Имя числового поля для статистики или рейтинга"
    },
    {
      "name": "aggregate",
      "type": "string",
      "required": false,
      "description": "Способ агрегации: sum/count/avg"
    },
    {
      "name": "topN",
      "type": "integer",
      "required": false,
      "description": "Максимальное число записей для ranking"
    }
  ]
}
