{
  "id": "SortData",
  "name": "Сортировка данных",
  "description": "Отсортировать данные в указанном диапазоне",
  "appType": "excel",
  "category": "Работа с данными",
  "riskLevel": "safe",
  "isVbaFallback": false,
  "parameters": [
    {
      "name": "range",
      "type": "string",
      "required": true,
      "description": "Диапазон данных для сортировки"
    },
    {
      "name": "sortColumn",
      "type": "integer",
      "required": true,
      "description": "Номер столбца сортировки (начиная с 1)"
    },
    {
      "name": "order",
      "type": "string",
      "required": false,
      "description": "Направление сортировки: asc/desc",
      "defaultValue": "asc"
    },
    {
      "name": "hasHeader",
      "type": "boolean",
      "required": false,
      "description": "Содержит заголовок",
      "defaultValue": true
    }
  ]
}