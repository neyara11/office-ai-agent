    {
      "name": "sourceRange",
      "type": "string",
      "required": true,
      "description": "Исходный диапазон данных, например A1:F100 или {selection}"
    },
    {
      "name": "targetSheet",
      "type": "string",
      "required": false,
      "description": "Имя листа отчёта"
    },
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "Заголовок отчёта"
    },
    {
      "name": "includeChart",
      "type": "boolean",
      "required": false,
      "description": "Также создать диаграмму"
    }
  ]
